########  ARRAYS ########
z<-c(1:1500)
dim(z) <- c(3,5,100)
x <- array(1:20, dim=c(4,5)) 		# Generate a 4 by 5 array.
i <- array(c(1:3,3:1), dim=c(3,2)) 	# i is a 3 by 2 index array
x[i]  								# Extract those elements
x[i] <- 0
z
dim(z)
